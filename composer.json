{
  "name": "wexample/php-json-schema",
  "description": "Named JSON schemas resolved into one document — references in place, inheritance folded — and data checked against them",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\PhpJsonSchema\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpJsonSchema\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.5",
    "opis/json-schema": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  }
}
